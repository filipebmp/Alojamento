{
  "name": "bookgest",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev -c app/wrangler.toml",
    "dev:plataforma": "wrangler dev -c plataforma/wrangler.toml",
    "db:migrate:local": "wrangler d1 migrations apply alojamento --local -c app/wrangler.toml",
    "db:migrate:plataforma:local": "wrangler d1 migrations apply plataforma --local -c plataforma/wrangler.toml",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gerar": "node scripts/gerar-estaticos.mjs",
    "pretypecheck": "npm run gerar --silent",
    "pretest": "npm run gerar --silent",
    "predev": "npm run gerar --silent"
  },
  "dependencies": {
    "hono": "4.13.13",
    "postal-mime": "4.0.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251106.1",
    "typescript": "5.9.3",
    "vitest": "4.0.5",
    "wrangler": "4.45.0"
  }
}
